@{
    ViewData["Title"] = "Home";
}

<div class="page-header text-center">
    <h1>MoneyTransfer</h1>
    <p>Manage organization finances, customer access, and project activity in one place.</p>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-5">
        <div class="section-card h-100 text-center">
            <h4 class="mb-2">Your Portal</h4>
            <p class="text-muted mb-4">
                Sign in to access your workspace. Admin and staff users are directed to the organization portal, while customer users are directed to their customer portal automatically after login.
            </p>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                Login
            </a>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="section-card h-100 text-center">
            <h4 class="mb-2">Getting Started</h4>
            <p class="text-muted mb-4">
                Create a new organization account to set up your workspace, invite internal users, and start managing clients and financial activity.
            </p>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary">
                Register Organization
            </a>
        </div>
    </div>
</div>

<div class="section-card mt-4">
    <h4 class="mb-3">What you can do</h4>
    <div class="row g-3">
        <div class="col-md-4">
            <div>
                <h6 class="mb-1">Track balances</h6>
                <p class="text-muted mb-0">Monitor project and client balances with ledger-based calculations and running balances.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div>
                <h6 class="mb-1">Manage financial activity</h6>
                <p class="text-muted mb-0">Create invoices, record payments, apply discounts, and review project financial details.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div>
                <h6 class="mb-1">Export statements</h6>
                <p class="text-muted mb-0">Generate PDF and Excel statements with filters, references, notes, and formatted balances.</p>
            </div>
        </div>
    </div>
</div>