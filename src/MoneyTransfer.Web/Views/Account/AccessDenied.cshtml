@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="page-header text-center">
            <h1>Access Denied</h1>
            <p>You do not have permission to access this page.</p>
        </div>

        <div class="section-card text-center">
            <p class="mb-3">Please return to a page available to your account or sign in with a different user.</p>

            <div class="page-actions justify-content-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Go to Home</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Login</a>
            </div>
        </div>
    </div>
</div>