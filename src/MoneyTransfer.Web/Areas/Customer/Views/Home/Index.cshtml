@model MoneyTransfer.Application.Services.Clients.ClientDetailsDto

@{
    ViewData["Title"] = "Customer Portal";
    ViewData["NavbarClientName"] = Model.Name;
}

<div class="page-header">
    <h1>@Model.Name</h1>
    <p class="mb-0 text-muted">@Model.OrganizationName</p>
</div>

<div class="summary-card">
    <div class="summary-grid">
        <div class="summary-item">
            <span class="summary-label">Total Balance</span>
            <span class="summary-value">$@Model.TotalBalance.ToString("0.00")</span>
        </div>
        <div class="summary-item">
            <span class="summary-label">As Of (UTC)</span>
            <span class="summary-value">@Model.AsOfDate.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
    </div>
</div>

<div class="section-card">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h4 class="mb-0">Projects</h4>
        <a asp-action="Transactions" class="btn btn-outline-primary">
            View Transactions
        </a>
    </div>

    @if (Model.Projects.Count == 0)
    {
        <div class="empty-state">
            No projects are available for this account.
        </div>
    }
    else
    {
        <div class="table-container">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Project</th>
                        <th>Code</th>
                        <th class="text-end">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var project in Model.Projects)
                    {
                        <tr>
                            <td>@project.ProjectName</td>
                            <td>@project.ProjectCode</td>
                            <td class="text-end">$@project.Balance.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>