@model IReadOnlyList<MoneyTransfer.Application.Services.Clients.ClientListItemDto>

@{
    ViewData["Title"] = "Clients";
    var search = ViewBag.Search as string;
    var selectedStatus = ViewBag.Status?.ToString();
}

<h1>Clients</h1>

<p>
    <a asp-area="Org" asp-controller="Clients" asp-action="Create" class="btn btn-primary">
        Create Client
    </a>
</p>

<form asp-area="Org" asp-controller="Clients" asp-action="Index" method="get">
    <div class="mb-3">
        <label for="search">Search</label>
        <input id="search" name="search" value="@search" class="form-control" />
    </div>

    <div class="mb-3">
        <label for="status">Status</label>
        <select id="status" name="status" class="form-select">
            <option value="0" selected="@(ViewBag.Status == null || selectedStatus == "Active")">Active</option>
            <option value="1" selected="@(selectedStatus == "Archived")">Archived</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Search</button>
    <a asp-area="Org" asp-controller="Clients" asp-action="Index" class="btn btn-secondary">Clear</a>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone Number</th>
            <th>Email</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="5">No clients found.</td>
            </tr>
        }
        else
        {
            foreach (var client in Model)
            {
                <tr>
                    <td>@client.Name</td>
                    <td>@client.PhoneNumber</td>
                    <td>@client.Email</td>
                    <td>@client.Status</td>
                    <td class="text-nowrap">
                        <a asp-area="Org"
                           asp-controller="Clients"
                           asp-action="Details"
                           asp-route-id="@client.Id"
                           class="btn btn-sm btn-info">
                            Details
                        </a>

                        <a asp-area="Org"
                           asp-controller="Clients"
                           asp-action="Edit"
                           asp-route-id="@client.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <form asp-area="Org"
                              asp-controller="Clients"
                              asp-action="Archive"
                              asp-route-id="@client.Id"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-sm btn-danger"
                                    onclick="return confirm('Are you sure you want to archive this client?');">
                                Archive
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>