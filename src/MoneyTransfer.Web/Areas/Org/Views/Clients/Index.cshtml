@model IReadOnlyList<MoneyTransfer.Application.Services.Clients.ClientListItemDto>

@{
    ViewData["Title"] = "Clients";
    ViewData["BackUrl"] = Url.Action("Index", "Home", new { area = "Org" });
    ViewData["BackText"] = "Back to Org Portal";

    var search = ViewBag.Search as string;
    var status = ViewBag.Status?.ToString();

    static string StatusBadgeClass(string? status) => status switch
    {
        "Active" => "bg-success text-white",
        "Archived" => "bg-secondary text-white",
        _ => "bg-light text-dark border"
    };
}

<div class="page-header">
    <h1>Clients</h1>
    <p>Manage client records, balances, and portal access.</p>
</div>

<div class="section-card">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h4 class="mb-0">Search & Filters</h4>
        <a asp-area="Org"
           asp-controller="Clients"
           asp-action="Create"
           class="btn btn-primary">
            Create Client
        </a>
    </div>

    <form method="get">
        <div class="row g-3">
            <div class="col-md-5">
                <label for="search" class="form-label">Search</label>
                <input id="search" name="search" value="@search" class="form-control" placeholder="Search clients..." />
            </div>

            <div class="col-md-3">
                <label for="status" class="form-label">Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="" selected="@(status == null)">All</option>
                    <option value="0" selected="@(status == "Active")">Active</option>
                    <option value="1" selected="@(status == "Archived")">Archived</option>
                </select>
            </div>

            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Apply Filters</button>
                <a asp-area="Org"
                   asp-controller="Clients"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Clear
                </a>
            </div>
        </div>
    </form>
</div>

<div class="section-card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            No clients found.
        </div>
    }
    else
    {
        <div class="table-container">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Phone Number</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model)
                    {
                        <tr>
                            <td>@client.Name</td>
                            <td>@client.PhoneNumber</td>
                            <td>@client.Email</td>
                            <td>
                                <span class="badge @StatusBadgeClass(client.Status.ToString())">
                                    @client.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex flex-wrap justify-content-end gap-2">
                                    <a asp-area="Org"
                                       asp-controller="Clients"
                                       asp-action="Details"
                                       asp-route-id="@client.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>

                                    <a asp-area="Org"
                                       asp-controller="Clients"
                                       asp-action="Edit"
                                       asp-route-id="@client.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <form asp-area="Org"
                                          asp-controller="Clients"
                                          asp-action="Archive"
                                          asp-route-id="@client.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Archive
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>