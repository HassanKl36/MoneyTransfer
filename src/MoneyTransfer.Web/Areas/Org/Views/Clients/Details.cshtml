@model MoneyTransfer.Application.Services.Clients.ClientDetailsDto

@{
    ViewData["Title"] = "Client Details";
}

<h1>Client Details</h1>

<div class="mb-4">
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Phone Number</dt>
        <dd class="col-sm-9">@Model.PhoneNumber</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</dd>

        <dt class="col-sm-3">Total Balance</dt>
        <dd class="col-sm-9">@Model.TotalBalance.ToString("0.00")</dd>
    </dl>
</div>

<h2>Statement Export</h2>

<p class="text-muted">
    Filters apply only to exported statements. This page does not display transactions.
</p>

<form method="get" class="mb-4">
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="mb-2">
        <label for="fromDate">From</label>
        <input id="fromDate" name="fromDate" type="date" class="form-control" />
    </div>

    <div class="mb-2">
        <label for="toDate">To</label>
        <input id="toDate" name="toDate" type="date" class="form-control" />
    </div>

    <div class="mb-2">
        <label for="projectId">Project</label>
        <select id="projectId" name="projectId" class="form-select">
            <option value="">All</option>
            @foreach (var project in Model.Projects)
            {
                <option value="@project.ProjectId">@project.ProjectName</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label for="transactionType">Transaction Type</label>
        <select id="transactionType" name="transactionType" class="form-select">
            <option value="">All</option>
            @foreach (var type in Enum.GetValues<MoneyTransfer.Domain.Enums.LedgerEntryType>())
            {
                <option value="@type">@type</option>
            }
        </select>
    </div>

    <button type="submit"
            formaction="@Url.Action("ExportPdf", "Clients", new { area = "Org" })"
            class="btn btn-secondary">
        Export PDF
    </button>

    <button type="submit"
            formaction="@Url.Action("ExportExcel", "Clients", new { area = "Org" })"
            class="btn btn-secondary">
        Export Excel
    </button>
</form>

<h2>Projects</h2>

@if (Model.Projects.Count == 0)
{
    <p>No projects found for this client.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Project</th>
                <th>Code</th>
                <th>Balance</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var project in Model.Projects)
            {
                <tr>
                    <td>@project.ProjectName</td>
                    <td>@project.ProjectCode</td>
                    <td>@project.Balance.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>
}

<p>
    <a asp-area="Org"
       asp-controller="Payments"
       asp-action="CreateClientAllocation"
       asp-route-clientId="@Model.Id"
       class="btn btn-primary">
        Record Client Payment Allocation
    </a>

    <a asp-area="Org" asp-controller="Clients" asp-action="Index" class="btn btn-secondary">Back to Clients</a>
</p>