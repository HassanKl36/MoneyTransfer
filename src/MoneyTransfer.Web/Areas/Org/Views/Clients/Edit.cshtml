@model MoneyTransfer.Application.Services.Clients.ClientEditDto

@{
    ViewData["Title"] = "Edit Client";
}

<h1>Edit Client</h1>

<form asp-area="Org" asp-controller="Clients" asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="HasPortalAccount" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select">
            <option value="0">Active</option>
            <option value="1">Archived</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <hr />

    @if (Model.HasPortalAccount)
    {
        <div class="alert alert-info">
            This client already has a portal account.
        </div>
    }
    else
    {
        <div class="form-check mb-3">
            <input asp-for="CreatePortalAccount" class="form-check-input" />
            <label asp-for="CreatePortalAccount" class="form-check-label">
                Create portal account
            </label>
        </div>

        <div class="mb-3">
            <label asp-for="PortalUsername" class="form-label">Username</label>
            <input asp-for="PortalUsername" class="form-control" />
            <span asp-validation-for="PortalUsername" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PortalPassword" class="form-label">Password</label>
            <input asp-for="PortalPassword" class="form-control" />
            <span asp-validation-for="PortalPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPortalPassword" class="form-label">Confirm Password</label>
            <input asp-for="ConfirmPortalPassword" class="form-control" />
            <span asp-validation-for="ConfirmPortalPassword" class="text-danger"></span>
        </div>
    }

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-area="Org" asp-controller="Clients" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}