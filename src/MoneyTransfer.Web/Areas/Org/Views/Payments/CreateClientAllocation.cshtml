@model MoneyTransfer.Application.Services.Payments.ClientPaymentCreateDto

@{
    ViewData["Title"] = "Record Client Payment Allocation";
    ViewData["BackUrl"] = Url.Action("Details", "Clients", new { area = "Org", id = Model.ClientId });
    ViewData["BackText"] = "Back to Client Details";
}

<div class="page-header">
    <h1>Record Client Payment Allocation</h1>
    <p>Record one client payment and distribute it across the client’s projects.</p>
</div>

<form asp-area="Org" asp-controller="Payments" asp-action="CreateClientAllocation" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="ClientId" type="hidden" />
    <input asp-for="ClientName" type="hidden" />

    <div class="summary-card">
        <div class="summary-grid">
            <div class="summary-item">
                <span class="summary-label">Client</span>
                <span class="summary-value">@Model.ClientName</span>
            </div>
        </div>
    </div>

    <div class="section-card">
        @if (ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
        {
            <div asp-validation-summary="All" class="alert alert-danger mb-4"></div>
        }

        <h4 class="mb-3">Payment Information</h4>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="TotalAmount" class="form-label"></label>
                <input asp-for="TotalAmount" type="number" min="0.01" step="0.01" class="form-control" />
                <span asp-validation-for="TotalAmount" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date" type="date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="PaymentMethod" class="form-label"></label>
                <input asp-for="PaymentMethod" class="form-control" />
                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="section-card">
        <h4 class="mb-3">Allocations</h4>

        @if (Model.AvailableProjects.Count == 0)
        {
            <div class="empty-state text-danger">
                This client has no available projects for allocation.
            </div>
        }
        else
        {
            <div class="table-container">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th>Code</th>
                            <th class="text-end">Current Balance</th>
                            <th>Allocate Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.AvailableProjects.Count; i++)
                        {
                            <tr>
                                <td>@Model.AvailableProjects[i].ProjectName</td>
                                <td>@Model.AvailableProjects[i].ProjectCode</td>
                                <td class="text-end">$@Model.AvailableProjects[i].CurrentBalance.ToString("0.00")</td>
                                <td>
                                    <input asp-for="Allocations[i].ProjectId" type="hidden" />
                                    <input asp-for="Allocations[i].Amount"
                                           type="number"
                                           min="0"
                                           step="0.01"
                                           class="form-control" />
                                    <span asp-validation-for="Allocations[i].Amount" class="text-danger"></span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="page-actions">
        <button type="submit" class="btn btn-primary">Save Allocation</button>
        <a asp-area="Org"
           asp-controller="Clients"
           asp-action="Details"
           asp-route-id="@Model.ClientId"
           class="btn btn-outline-secondary">
            Cancel
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}