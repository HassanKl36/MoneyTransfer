@model IReadOnlyList<MoneyTransfer.Application.Services.Payments.PaymentListItemDto>

@{
    ViewData["Title"] = "Payments";
    var projectId = (Guid)ViewBag.ProjectId;
}

<h1>Payments</h1>

<p>
    <a asp-area="Org"
       asp-controller="Payments"
       asp-action="Create"
       asp-route-projectId="@projectId"
       class="btn btn-primary">
        Record Payment
    </a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No payments found for this project.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Payment Reference</th>
                <th>Amount</th>
                <th>Description</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var payment in Model)
            {
                <tr>
                    <td>@payment.PaymentReference</td>
                    <td>@payment.Amount</td>
                    <td>@payment.Description</td>
                    <td>@payment.Date.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}