@model IReadOnlyList<MoneyTransfer.Application.Services.Projects.ProjectListItemDto>

@{
    ViewData["Title"] = "Projects";
    var search = ViewBag.Search as string;
    var selectedStatus = ViewBag.Status?.ToString();
}

<h1>Projects</h1>

<p>
    <a asp-area="Org" asp-controller="Projects" asp-action="Create" class="btn btn-primary">Create Project</a>
</p>

<form method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-5">
            <input name="search" value="@search" class="form-control" placeholder="Search projects..." />
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="" selected="@(ViewBag.Status == null)">Open</option>
                <option value="0" selected="@(selectedStatus == "Active")">Active</option>
                <option value="1" selected="@(selectedStatus == "Completed")">Completed</option>
                <option value="2" selected="@(selectedStatus == "Archived")">Archived</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </div>
        <div class="col-auto">
            <a asp-area="Org" asp-controller="Projects" asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Client</th>
            <th>Code</th>
            <th>Description</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="6">No projects found.</td>
            </tr>
        }
        else
        {
            foreach (var project in Model)
            {
                <tr>
                    <td>@project.Name</td>
                    <td>@project.ClientName</td>
                    <td>@project.Code</td>
                    <td>@project.Description</td>
                    <td>@project.Status</td>
                    <td class="text-end">

                        <a asp-area="Org"
                           asp-controller="Projects"
                           asp-action="Edit"
                           asp-route-id="@project.Id"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <a asp-area="Org"
                           asp-controller="Projects"
                           asp-action="Details"
                           asp-route-id="@project.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Details
                        </a>

                        <a asp-area="Org"
                           asp-controller="Invoices"
                           asp-action="Index"
                           asp-route-projectId="@project.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Invoices
                        </a>

                        <a asp-area="Org"
                           asp-controller="Payments"
                           asp-action="Index"
                           asp-route-projectId="@project.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Payments
                        </a>

                        <form asp-area="Org"
                              asp-controller="Projects"
                              asp-action="Archive"
                              asp-route-id="@project.Id"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Archive
                            </button>
                        </form>

                    </td>
                </tr>
            }
        }
    </tbody>
</table>