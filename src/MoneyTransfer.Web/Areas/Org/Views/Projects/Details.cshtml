@model MoneyTransfer.Application.Services.Projects.ProjectLedgerDetailsDto
@using MoneyTransfer.Domain.Enums

@{
    ViewData["Title"] = "Project Details";
    ViewData["BackUrl"] = Url.Action("Index", "Projects", new { area = "Org" });
    ViewData["BackText"] = "Back to Projects";

    var projectId = ViewContext.RouteData.Values["id"]?.ToString();
    var projectDetailsBackUrl = Url.Action("Details", "Projects", new { area = "Org", id = projectId });
}

<div class="page-header d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h1>Project Details</h1>
        <p class="mb-0">Review project totals and ledger activity.</p>
    </div>

    <div class="page-actions mb-0">
        <a asp-area="Org"
           asp-controller="Invoices"
           asp-action="Index"
           asp-route-projectId="@projectId"
           asp-route-backUrl="@projectDetailsBackUrl"
           asp-route-backText="Back to Project Details"
           class="btn btn-primary">
            Invoices
        </a>

        <a asp-area="Org"
           asp-controller="Payments"
           asp-action="Index"
           asp-route-projectId="@projectId"
           asp-route-backUrl="@projectDetailsBackUrl"
           asp-route-backText="Back to Project Details"
           class="btn btn-primary">
            Payments
        </a>

        <a asp-area="Org"
           asp-controller="Discounts"
           asp-action="Index"
           asp-route-projectId="@projectId"
           asp-route-backUrl="@projectDetailsBackUrl"
           asp-route-backText="Back to Project Details"
           class="btn btn-primary">
            Discounts
        </a>

        @if (User.IsInRole("Admin"))
        {
            <a asp-area="Org"
               asp-controller="Adjustments"
               asp-action="Create"
               asp-route-projectId="@projectId"
               asp-route-backUrl="@projectDetailsBackUrl"
               asp-route-backText="Back to Project Details"
               class="btn btn-primary">
                Create Adjustment
            </a>
        }
    </div>
</div>

<div class="summary-card">
    <div class="summary-grid">
        <div class="summary-item">
            <span class="summary-label">Total Invoiced</span>
            <span class="summary-value">$@Model.TotalInvoiced.ToString("0.00")</span>
        </div>
        <div class="summary-item">
            <span class="summary-label">Total Paid</span>
            <span class="summary-value">$@Model.TotalPaid.ToString("0.00")</span>
        </div>
        <div class="summary-item">
            <span class="summary-label">Total Discounted</span>
            <span class="summary-value">$@Model.TotalDiscounted.ToString("0.00")</span>
        </div>
        <div class="summary-item">
            <span class="summary-label">Remaining Balance</span>
            <span class="summary-value">$@Model.RemainingBalance.ToString("0.00")</span>
        </div>
    </div>
</div>

<div class="section-card">
    <h4 class="mb-3">Ledger Filters</h4>

    <form method="get">
        <input type="hidden" name="id" value="@projectId" />

        <div class="row g-3">
            <div class="col-md-3">
                <label for="fromDate" class="form-label">From Date</label>
                <input type="date"
                       id="fromDate"
                       name="fromDate"
                       value="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label for="toDate" class="form-label">To Date</label>
                <input type="date"
                       id="toDate"
                       name="toDate"
                       value="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label for="transactionType" class="form-label">Transaction Type</label>
                <select id="transactionType" name="transactionType" class="form-select">
                    <option value="">All</option>
                    @foreach (var type in Enum.GetValues<LedgerEntryType>())
                    {
                        if (Model.TransactionType == type)
                        {
                            <option value="@type" selected="selected">@type</option>
                        }
                        else
                        {
                            <option value="@type">@type</option>
                        }
                    }
                </select>
            </div>

            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Apply Filters</button>
                <a asp-area="Org"
                   asp-controller="Projects"
                   asp-action="Details"
                   asp-route-id="@projectId"
                   class="btn btn-outline-secondary">
                    Clear
                </a>
            </div>
        </div>
    </form>
</div>

<div class="section-card">
    <h4 class="mb-3">Ledger Entries</h4>

    @if (Model.Entries.Count == 0)
    {
        <div class="empty-state">
            No ledger entries were found for the selected filters.
        </div>
    }
    else
    {
        <div class="table-container">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th class="text-end">Amount</th>
                        <th>Reference</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td>@entry.OccurredAt.ToString("dd/MM/yyyy")</td>
                            <td>@entry.Type</td>
                            <td class="text-end">$@entry.Amount.ToString("0.00")</td>
                            <td>@entry.Reference</td>
                            <td>@entry.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="page-actions">
    <a asp-area="Org" asp-controller="Projects" asp-action="Index" class="btn btn-outline-secondary">
        Back to Projects
    </a>
</div>