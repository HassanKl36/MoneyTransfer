@{
}
@model MoneyTransfer.Application.Services.Projects.ProjectFinancialSummaryDto

@{
    ViewData["Title"] = "Project Financial Summary";
}

<h1>Project Financial Summary</h1>

<div class="mt-4">
    <dl class="row">
        <dt class="col-sm-3">Total Invoiced</dt>
        <dd class="col-sm-9">@Model.TotalInvoiced</dd>

        <dt class="col-sm-3">Total Paid</dt>
        <dd class="col-sm-9">@Model.TotalPaid</dd>

        <dt class="col-sm-3">Remaining Balance</dt>
        <dd class="col-sm-9">@Model.RemainingBalance</dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-area="Org" asp-controller="Projects" asp-action="Index" class="btn btn-secondary">
        Back to Projects
    </a>
</div>