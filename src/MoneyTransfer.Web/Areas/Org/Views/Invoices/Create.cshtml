@model MoneyTransfer.Application.Services.Invoices.InvoiceCreateDto

@{
    ViewData["Title"] = "Create Invoice";
}

<h1>Create Invoice</h1>

<form asp-area="Org" asp-controller="Invoices" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="ProjectId" type="hidden" />

    <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-area="Org"
       asp-controller="Invoices"
       asp-action="Index"
       asp-route-projectId="@Model.ProjectId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}