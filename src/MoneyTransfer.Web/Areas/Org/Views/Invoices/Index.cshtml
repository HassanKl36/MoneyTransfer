@model IReadOnlyList<MoneyTransfer.Application.Services.Invoices.InvoiceListItemDto>

@{
    ViewData["Title"] = "Invoices";
    ViewData["BackUrl"] = ViewBag.BackUrl as string ?? Url.Action("Index", "Projects", new { area = "Org" });
    ViewData["BackText"] = ViewBag.BackText as string ?? "Back to Projects";

    var projectId = (Guid)ViewBag.ProjectId;
    var backUrl = ViewBag.BackUrl as string;
    var backText = ViewBag.BackText as string;
}

<div class="page-header">
    <h1>Invoices</h1>
    <p>Review project invoices and create new billing records.</p>
</div>

<div class="section-card">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h4 class="mb-0">Invoice Records</h4>
        <a asp-area="Org"
           asp-controller="Invoices"
           asp-action="Create"
           asp-route-projectId="@projectId"
           asp-route-backUrl="@backUrl"
           asp-route-backText="@backText"
           class="btn btn-primary">
            Create Invoice
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            No invoices found for this project.
        </div>
    }
    else
    {
        <div class="table-container">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Invoice Number</th>
                        <th>Status</th>
                        <th class="text-end">Amount</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in Model)
                    {
                        <tr>
                            <td>@invoice.InvoiceNumber</td>
                            <td>
                                @if (invoice.IsVoided)
                                {
                                    <span class="badge bg-secondary">Voided</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="text-end">$@invoice.Amount.ToString("0.00")</td>
                            <td>@invoice.Description</td>
                            <td>@invoice.Date.ToString("dd/MM/yyyy") @invoice.CreatedAt.ToString("HH:mm")</td>
                            <td class="text-end">
                                @if (!invoice.IsVoided && User.IsInRole("Admin"))
                                {
                                    <form asp-area="Org"
                                          asp-controller="Invoices"
                                          asp-action="Void"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Void this invoice? This will create a reversing ledger entry.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@invoice.Id" />
                                        <input type="hidden" name="projectId" value="@projectId" />
                                        <input type="hidden" name="backUrl" value="@backUrl" />
                                        <input type="hidden" name="backText" value="@backText" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Void
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">No actions</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>