@model MoneyTransfer.Application.Services.Adjustments.AdjustmentCreateDto

@{
    ViewData["Title"] = "Create Adjustment";
    ViewData["BackUrl"] = ViewBag.BackUrl as string;
    ViewData["BackText"] = ViewBag.BackText as string ?? "Back";
}

<div class="page-header">
    <h1>Create Adjustment</h1>
    <p>Add a positive or negative correction entry for the selected project.</p>
</div>

<form asp-area="Org" asp-controller="Adjustments" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="backUrl" value="@(ViewBag.BackUrl as string)" />
    <input type="hidden" name="backText" value="@(ViewBag.BackText as string)" />
    <input asp-for="ProjectId" type="hidden" />

    <div class="section-card">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
                <div class="form-text">Use a positive amount to increase balance or a negative amount to decrease balance.</div>
            </div>

            <div class="col-md-4">
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date" type="date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Reason" class="form-label"></label>
                <textarea asp-for="Reason" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="page-actions">
        <button type="submit" class="btn btn-primary">Save Adjustment</button>

        @if (!string.IsNullOrWhiteSpace(ViewBag.BackUrl as string))
        {
            <a href="@(ViewBag.BackUrl as string)" class="btn btn-outline-secondary">
                @(ViewBag.BackText as string ?? "Cancel")
            </a>
        }
        else
        {
            <a asp-area="Org"
               asp-controller="Projects"
               asp-action="Details"
               asp-route-id="@Model.ProjectId"
               class="btn btn-outline-secondary">
                Cancel
            </a>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}